# Work identity. This repo is public; the employer's GitHub org and email
# address live only on the machine, in ~/.config/git/{config.local,config.work}.
# These patterns are belt-and-braces — those files are outside the repo — but
# `mise bootstrap dotfiles add` would otherwise capture them happily.
home/.config/git/config.local
home/.config/git/config.work

# Secrets — never commit these, even if a dotfiles entry would otherwise carry them.
home/.config/gh/hosts.yml
**/*.token
**/*_rsa
**/*.pem
.env
.env.*

# Machine-local state that tools write back into their own config dirs.
#
# Most of these are now structurally prevented rather than merely ignored: the
# directories below are linked with `mode = "symlink-each"`, which links the
# files we own individually and leaves the directory itself real, so a tool
# writing a sibling writes it into ~ and never into this repo. They stay listed
# because `mise bootstrap dotfiles add` would otherwise happily capture them.
home/.config/karabiner/automatic_backups/
home/.config/nvim/.netrwhist
home/.config/nvim/spell/
home/.config/herdr/session.json
home/.config/herdr/.plugins.lock
home/.config/herdr/*.log
home/.config/herdr/*.sock

# tmux plugin manager and everything it installs. Cloned by [bootstrap.repos]
# into ~/.config/tmux/plugins, which is a real directory beside the
# symlink-each'd config files.
home/.config/tmux/plugins/

# macOS noise.
.DS_Store
