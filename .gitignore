# These files live outside the repo; the patterns exist because
# `mise bootstrap dotfiles add` would otherwise capture them.
home/.config/git/config.local
home/.config/git/config.work

# Secrets — never commit these
home/.config/gh/hosts.yml
**/*.token
**/*_rsa
**/*.pem
.env
.env.*

# Load-bearing: ~/.config/nvim is a whole-directory symlink.
home/.config/nvim/.netrwhist
home/.config/nvim/spell/

# Nothing writes here — these are single-file links — but
# `mise bootstrap dotfiles add` would otherwise capture them.
home/.config/karabiner/automatic_backups/
home/.config/herdr/session.json
home/.config/herdr/.plugins.lock
home/.config/herdr/*.log
home/.config/herdr/*.sock

# agent.db is a credential store in the same directory as the one file we
# link, so the whole tree is denied except ~/.omp/agent/config.yml.
home/.omp/*
!home/.omp/agent/
home/.omp/agent/*
!home/.omp/agent/config.yml

# ~/.claude is a state directory: sessions, transcripts, caches and a
# herdr-installed hook all sit beside the three files this repo owns.
home/.claude/*
!home/.claude/settings.json
!home/.claude/statusline-command.sh
!home/.claude/keybindings.json

.DS_Store
