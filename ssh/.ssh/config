# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

# ---------------------------------------------------------------------------
# 1Password SSH agent + explicit per-account key selection.
#
# Each IdentityFile below is a PUBLIC key stub in ~/.ssh/1password/. ssh uses it
# only to tell the agent *which* key to use; the private key never leaves
# 1Password. IdentitiesOnly=yes stops ssh offering every key in the agent, which
# is what caused the wrong account to authenticate (and eventually
# "Too many authentication failures" once the agent holds >6 keys).
#
# Regenerate the stubs after adding/renaming keys in 1Password:
#   ~/.ssh/1password/refresh
# ---------------------------------------------------------------------------

# GitHub - personal account (jonnyasmith). Default for github.com.
Host github.com
  HostName github.com
  User git
  IdentitiesOnly yes
  IdentityFile ~/.ssh/1password/github-personal.pub

# GitHub - work account (jonnysmith-work). Reached via the URL rewrite in
# ~/.gitconfig, so any github.com/work/* remote lands here automatically.
Host github-work
  HostName github.com
  User git
  IdentitiesOnly yes
  IdentityFile ~/.ssh/1password/github-work.pub

# Azure DevOps - only the RSA key is registered there.
Host ssh.dev.azure.com vs-ssh.visualstudio.com
  User git
  IdentitiesOnly yes
  IdentityFile ~/.ssh/1password/azure-work.pub
  PubkeyAcceptedAlgorithms +ssh-rsa
  HostkeyAlgorithms +ssh-rsa

# Global: point SSH at 1Password's agent
Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# Pi Zero Development Server
Host pi-development.local
  HostName pi-development.local
  User jonny
  ForwardAgent yes

# Home Pi
Host homepi.local
  HostName homepi.local
  User jonny
  ForwardAgent yes

