#!/usr/bin/env bash
# Regenerate the public-key stubs that ~/.ssh/config pins per host.
set -euo pipefail

{%- if os() == "macos" %}
export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{%- elif os() == "linux" %}
export SSH_AUTH_SOCK="$HOME/.1password/agent.sock"
{%- endif %}
# Write straight into the working tree: ~/.ssh/config names the stubs by their
# in-repo path, so regenerating them shows up as a plain git diff to commit.
dir="$HOME/.dotfiles/home/.ssh/1password"

# The work items are titled "... Work" rather than after the employer, so this
# public repo names no client. An unmapped key is reported and skipped.
map() {
  case "$1" in
    "SSH Key - Ed25519")      echo github-personal ;;
    "SSH Key - Ed25519 Work") echo github-work ;;
    "SSH Key - Work")         echo azure-work ;;
    *)                        echo "" ;;
  esac
}

[[ -S $SSH_AUTH_SOCK ]] || { echo "1Password agent socket not found; is 1Password running with the SSH agent enabled?" >&2; exit 1; }

mkdir -p "$dir"
found=0
while read -r type key comment; do
  [[ -n ${type:-} ]] || continue
  name=$(map "$comment")
  if [[ -z $name ]]; then
    echo "skip: unmapped 1Password key '$comment' (add it to map() above)" >&2
    continue
  fi
  printf '%s %s %s\n' "$type" "$key" "$comment" > "$dir/$name.pub"
  chmod 600 "$dir/$name.pub"
  echo "wrote $dir/$name.pub  <- $comment"
  found=$((found + 1))
done < <(ssh-add -L)

[[ $found -gt 0 ]] || { echo "no keys returned by the agent" >&2; exit 1; }
