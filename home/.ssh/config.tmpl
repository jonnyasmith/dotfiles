# Rendered from home/.ssh/config.tmpl — edit the template, not this file.
{%- if os() == "macos" %}
# ssh_config is first-value-wins, so this Include must stay above the `Host *`
# block below. OrbStack is macOS-only, hence the guard.
Include ~/.orbstack/ssh/config
{%- endif %}

# `Match originalhost`, not `Host`, is deliberate: a `Host github.com` block
# would also match the github-work alias, which sets `HostName github.com`.
Match originalhost github.com
  HostName github.com
  User git
  IdentitiesOnly yes
  IdentityFile ~/.dotfiles/home/.ssh/1password/github-personal.pub

# ~/.config/git/config.local rewrites work remotes to this alias.
Match originalhost github-work
  HostName github.com
  User git
  IdentitiesOnly yes
  IdentityFile ~/.dotfiles/home/.ssh/1password/github-work.pub

# Only the RSA key is registered with Azure DevOps.
Match originalhost ssh.dev.azure.com,vs-ssh.visualstudio.com
  User git
  IdentitiesOnly yes
  IdentityFile ~/.dotfiles/home/.ssh/1password/azure-work.pub
  PubkeyAcceptedAlgorithms +ssh-rsa
  HostkeyAlgorithms +ssh-rsa

Host *
{%- if os() == "macos" %}
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{%- elif os() == "linux" %}
  IdentityAgent ~/.1password/agent.sock
{%- endif %}

Host pi-development.local
  HostName pi-development.local
  User jonny
  ForwardAgent yes

Host homepi.local
  HostName homepi.local
  User jonny
  ForwardAgent yes
