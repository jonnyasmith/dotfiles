# Applied by [tasks."setup:gtk"] with `dconf load /`. Keys that GTK apps read
# for themselves, so this file applies wherever dconf exists; anything a
# *shell* interprets belongs in gnome.dconf.

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
enable-animations=false
font-antialiasing='rgba'
font-hinting='full'

[org/gtk/settings/file-chooser]
show-hidden=true
sort-directories-first=true

[org/gtk/gtk4/settings/file-chooser]
show-hidden=true
sort-directories-first=true
